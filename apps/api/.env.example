# --- Neon Postgres ---
# Pooled connection (host contains "-pooler"), used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection (no "-pooler"), used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
FREE_AI_DAILY_LIMIT=10
PREMIUM_AI_DAILY_LIMIT=300
# Optional: override the Gemini endpoint (corporate proxy, or a local mock server for testing)
GEMINI_BASE_URL=""

# --- URLs ---
WEB_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"
# Comma separated list of allowed browser origins (defaults to WEB_URL)
CORS_ORIGINS="http://localhost:3000"

# --- Payments: Chapa (https://dashboard.chapa.co) ---
CHAPA_SECRET_KEY=""
# Set to "true" to simulate successful payments (development / demo only!)
PAYMENTS_MOCK="false"

# --- Email: Resend (https://resend.com) — password reset emails ---
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. "Lisan <no-reply@lisan.et>"
EMAIL_FROM="Lisan <onboarding@resend.dev>"

# --- Seed: first admin account ---
ADMIN_EMAIL="admin@lisan.et"
ADMIN_PASSWORD="ChangeMe123!"

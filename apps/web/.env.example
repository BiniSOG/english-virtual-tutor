# URL of the deployed NestJS API (used by the /api/* rewrite proxy)
API_URL="http://localhost:4000"
# Shown on the login page for password resets, e.g. "support@yourdomain.et or Telegram @yourhandle"
NEXT_PUBLIC_SUPPORT_CONTACT=""
# Optional: call the API directly from the browser instead of through the /api rewrite proxy
# (e.g. "https://your-api.vercel.app"). Requires CORS_ORIGINS on the API to include this site.
NEXT_PUBLIC_API_URL=""
